# --- 秘密情報(APIキー等) ---
.env

# --- Python / 環境 ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- モデル・実行ファイル(大容量。scripts/setup_models.py で取得、本人声は server/piper_train/ で学習) ---
