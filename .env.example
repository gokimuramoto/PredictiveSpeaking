# このファイルを .env にコピーして値を埋める(.env はgit管理外)

# --- 必須: 音声認識 (Azure Speech) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# --- 任意: GPUサーバを使う構成(日本語版 / サーバ型TTS / ベンチ)---
# 候補ホストをカンマ区切りで優先順に(LAN→VPN等)。先に届いたものを使う
# PS_SERVER_HOSTS=192.168.0.10,my-gpu-server
# ベンチ用スクリプト(tournament.py)がsshする接続名(~/.ssh/config の Host)
# PS_SSH_HOST=my-gpu-server

# --- 任意: ローカルLLMの場所(既定: models/llm/ に llama-server と gguf) ---
# PS_LLM_DIR=models/llm
# PS_LLM_MODEL=qwen3-4b-q4_k_m.gguf
